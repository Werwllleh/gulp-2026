include ../../pug/index
include ../../../components/index
include ../../../blocks/index

block vars
    - var stylesLibs = []
    - var scriptsLibs = []
    - var stylesComponents = []
    - var scriptsComponents = []
    - var stylesBlocks = []
    - var scriptsBlocks = []
    - var stylePage = ''
    - var scriptPage = ''

    - var title = "Document"
    - var description = "Document description"

block use

doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        base(href="./")
        title= title
        meta(name="description" content="" + description)

        // Базовые стили
        link(rel="stylesheet", href="css/app.css")
        // Стили страницы (если есть)
        if stylePage
            link(rel="stylesheet", href=`${stylePage}/${stylePage}.css`)
    body
        +header()

        main.page
            block content

        +footer()


        .styles-libs
            // Стили библиотек
            link(rel="stylesheet", href=`libs/lightgallery/lightgallery-bundle.min.css`)
            link(rel="stylesheet", href=`libs/swiper/swiper-bundle.min.css`)
            link(rel="stylesheet", href=`libs/tippy/tippy.css`)
            each style in stylesLibs
                link(rel="stylesheet", href=`libs/${style}`)

        // Скрипты библиотек
        each script in scriptsLibs
            script(src=`libs/${script}`)
        // Скрипты общие
        script(src=`js/app.js`)
        // Скрипты страницы
        if scriptPage
            script(src=`${scriptPage}/${scriptPage}.js`)
        include ../../../sprite/sprite.svg
